# Local defaults. Optional overrides can be copied into .env.
CUSTOMS_PAGE_MODE=live
CUSTOMS_ENGINE_MODE=mock
CUSTOMS_EXECUTOR_MODE=inline
CUSTOMS_SQLITE_PATH=.local/db.sqlite3
# make setup creates a persistent local Django key. To override, set DJANGO_SECRET_KEY.

# P05 受控文件存储（原件/图片/导出副本）。默认 .local/files，已被 Git 忽略；
# 相对路径按仓库根目录解析。上限单位为字节，必须是正整数，解析失败启动即报错。
# CUSTOMS_FILE_ROOT=.local/files
# CUSTOMS_FILE_MAX_BYTES=104857600
# CUSTOMS_IMAGE_MAX_BYTES=20971520
# CUSTOMS_FILE_READ_MAX_BYTES=209715200

# 推荐 PostgreSQL：复制本模板为 .env 后先执行 scripts/database/bootstrap.sh。
# 缺 NAME/USER 会立即报错，不会静默回退。快速 SQLite 开发可显式改后端为 sqlite。
# 切库/保留旧数据/完整备份恢复：scripts/database/README.md。
CUSTOMS_DB_BACKEND=postgres
CUSTOMS_PG_NAME=customs_agent
CUSTOMS_PG_USER=customs_agent
# CUSTOMS_PG_PASSWORD=
CUSTOMS_PG_HOST=127.0.0.1
CUSTOMS_PG_PORT=5432

# P06: dotted callable(user, queryset), blank = shared trial operator pool
CUSTOMS_CLAIM_SCOPE_POLICY=

# 业务员提交时：已有有效任务专家则沿用，否则授权这个已存在且启用的专家账号。
# 开发 seed-demo 账号为 expert；真实试用改成实际账号，不会自动创建账号或重置密码。
# 未配置可用账号时明确拒绝提交，不留下无人可审的 pending。
CUSTOMS_DEFAULT_EXPERT_USERNAME=expert
