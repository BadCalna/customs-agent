{
  "$defs": {
    "EvidenceStatus": {
      "description": "逐来源的证据取得状态；查询失败与确实未查得必须分开。",
      "enum": [
        "obtained",
        "not_found",
        "query_failed",
        "version_unverified"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    }
  },
  "description": "一条可定位的依据。查询无结果时不生成虚构条款。",
  "properties": {
    "document": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document"
    },
    "effective_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective From"
    },
    "effective_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective To"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "excerpt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt"
    },
    "issued_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Issued At"
    },
    "locator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "条款、页码或章节定位",
      "title": "Locator"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "query": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query"
    },
    "retrieved_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieved At"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "source_type": {
      "title": "Source Type",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EvidenceStatus"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "required": [
    "evidence_id",
    "source_type",
    "title",
    "status"
  ],
  "title": "EvidenceEntry",
  "type": "object"
}
