{
  "$defs": {
    "EvidenceEntry": {
      "description": "一条可定位的依据。查询无结果时不生成虚构条款。",
      "properties": {
        "document": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document"
        },
        "effective_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "issued_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issued At"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "条款、页码或章节定位",
          "title": "Locator"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "query": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "evidence_id",
        "source_type",
        "title",
        "status"
      ],
      "title": "EvidenceEntry",
      "type": "object"
    },
    "EvidenceStatus": {
      "description": "逐来源的证据取得状态；查询失败与确实未查得必须分开。",
      "enum": [
        "obtained",
        "not_found",
        "query_failed",
        "version_unverified"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "ExecutionContext": {
      "description": "共有执行上下文，标识一律由服务端注入。",
      "properties": {
        "engine_version": {
          "default": "",
          "title": "Engine Version",
          "type": "string"
        },
        "input_hash": {
          "default": "",
          "title": "Input Hash",
          "type": "string"
        },
        "input_revision": {
          "title": "Input Revision",
          "type": "integer"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "mock_scenario": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "仅 mock 引擎使用的固定场景选择键；真实引擎忽略，不参与业务判断",
          "title": "Mock Scenario"
        },
        "prompt_version": {
          "default": "",
          "title": "Prompt Version",
          "type": "string"
        },
        "result_mode": {
          "$ref": "#/$defs/ResultMode",
          "default": "mock"
        },
        "rules_version": {
          "default": "",
          "title": "Rules Version",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "version_id",
        "item_id",
        "run_id",
        "input_revision"
      ],
      "title": "ExecutionContext",
      "type": "object"
    },
    "ImageFact": {
      "description": "图片只支持可见事实；读取失败不得推断工艺、材质或税务条件。",
      "properties": {
        "error_message": {
          "default": "",
          "title": "Error Message",
          "type": "string"
        },
        "image_id": {
          "title": "Image Id",
          "type": "string"
        },
        "source_cell": {
          "title": "Source Cell",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "visible_description": {
          "default": "",
          "title": "Visible Description",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "status",
        "source_cell"
      ],
      "title": "ImageFact",
      "type": "object"
    },
    "ResultMode": {
      "description": "结果来源模式。mock 结果必须在页面上可识别，不冒充真实引擎结论。",
      "enum": [
        "mock",
        "live"
      ],
      "title": "ResultMode",
      "type": "string"
    }
  },
  "description": "专家核查输入：绑定不可变提交快照，核查对象是提交码。",
  "properties": {
    "attributes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Attributes",
      "type": "object"
    },
    "context": {
      "$ref": "#/$defs/ExecutionContext"
    },
    "elements_text": {
      "default": "",
      "title": "Elements Text",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceEntry"
      },
      "title": "Evidence",
      "type": "array"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/ImageFact"
      },
      "title": "Images",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "submission_id": {
      "title": "Submission Id",
      "type": "string"
    },
    "submitted_hs": {
      "title": "Submitted Hs",
      "type": "string"
    },
    "supplier_tax_rate_raw": {
      "default": "",
      "title": "Supplier Tax Rate Raw",
      "type": "string"
    }
  },
  "required": [
    "context",
    "submission_id",
    "submitted_hs",
    "name"
  ],
  "title": "ExpertCheckInput",
  "type": "object"
}
