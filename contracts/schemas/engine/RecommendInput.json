{
  "$defs": {
    "ExecutionContext": {
      "description": "共有执行上下文，标识一律由服务端注入。",
      "properties": {
        "engine_version": {
          "default": "",
          "title": "Engine Version",
          "type": "string"
        },
        "input_hash": {
          "default": "",
          "title": "Input Hash",
          "type": "string"
        },
        "input_revision": {
          "title": "Input Revision",
          "type": "integer"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "mock_scenario": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "仅 mock 引擎使用的固定场景选择键；真实引擎忽略，不参与业务判断",
          "title": "Mock Scenario"
        },
        "prompt_version": {
          "default": "",
          "title": "Prompt Version",
          "type": "string"
        },
        "result_mode": {
          "$ref": "#/$defs/ResultMode",
          "default": "mock"
        },
        "rules_version": {
          "default": "",
          "title": "Rules Version",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "version_id",
        "item_id",
        "run_id",
        "input_revision"
      ],
      "title": "ExecutionContext",
      "type": "object"
    },
    "ImageFact": {
      "description": "图片只支持可见事实；读取失败不得推断工艺、材质或税务条件。",
      "properties": {
        "error_message": {
          "default": "",
          "title": "Error Message",
          "type": "string"
        },
        "image_id": {
          "title": "Image Id",
          "type": "string"
        },
        "source_cell": {
          "title": "Source Cell",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "visible_description": {
          "default": "",
          "title": "Visible Description",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "status",
        "source_cell"
      ],
      "title": "ImageFact",
      "type": "object"
    },
    "ResultMode": {
      "description": "结果来源模式。mock 结果必须在页面上可识别，不冒充真实引擎结论。",
      "enum": [
        "mock",
        "live"
      ],
      "title": "ResultMode",
      "type": "string"
    }
  },
  "description": "独立推荐输入：精简 DTO，刻意不含 supplier_hs_raw 与任何阶段结果。",
  "properties": {
    "anchoring_notes": {
      "items": {
        "type": "string"
      },
      "title": "Anchoring Notes",
      "type": "array"
    },
    "attributes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Attributes",
      "type": "object"
    },
    "context": {
      "$ref": "#/$defs/ExecutionContext"
    },
    "elements_text": {
      "default": "",
      "description": "申报要素原文；其中可能自然出现编码，由输入构造器在 anchoring_notes 记录",
      "title": "Elements Text",
      "type": "string"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/ImageFact"
      },
      "title": "Images",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "query_basis": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "查询基准；系统不填拟申报日期",
      "title": "Query Basis",
      "type": "object"
    }
  },
  "required": [
    "context",
    "name"
  ],
  "title": "RecommendInput",
  "type": "object"
}
