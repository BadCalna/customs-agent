{
  "$defs": {
    "HistoryIssue": {
      "description": "人工问题的确切归属。旧记录无法证明的引用保留 null，不猜测到当前版本。",
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "default": "",
          "title": "Created By",
          "type": "string"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Id"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "return_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return To"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "submission_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submission Id"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Id"
        }
      },
      "required": [
        "issue_id",
        "task_id",
        "kind",
        "message",
        "status",
        "created_at"
      ],
      "title": "HistoryIssue",
      "type": "object"
    },
    "SourceLocation": {
      "description": "商品行在原 Excel 中的位置；行号为 1 起始。",
      "properties": {
        "cells": {
          "default": "",
          "title": "Cells",
          "type": "string"
        },
        "row_number": {
          "minimum": 1,
          "title": "Row Number",
          "type": "integer"
        },
        "sheet_name": {
          "title": "Sheet Name",
          "type": "string"
        }
      },
      "required": [
        "sheet_name",
        "row_number"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "TaskStage": {
      "enum": [
        "uploaded",
        "prechecking",
        "awaiting_confirmation",
        "submitted",
        "approved",
        "returned"
      ],
      "title": "TaskStage",
      "type": "string"
    }
  },
  "properties": {
    "idempotent_replay": {
      "default": false,
      "title": "Idempotent Replay",
      "type": "boolean"
    },
    "issue_ids": {
      "items": {
        "type": "string"
      },
      "title": "Issue Ids",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/HistoryIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "stage": {
      "$ref": "#/$defs/TaskStage"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "task_revision": {
      "title": "Task Revision",
      "type": "integer"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "version_id",
    "stage",
    "task_revision",
    "issue_ids"
  ],
  "title": "TaskReturnOut",
  "type": "object"
}
