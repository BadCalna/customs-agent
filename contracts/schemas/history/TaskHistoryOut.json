{
  "$defs": {
    "CrossVersionCandidate": {
      "description": "跨版本对照只是候选展示，不建立稳定的商品身份。",
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "candidate_item_id": {
          "title": "Candidate Item Id",
          "type": "string"
        },
        "candidate_version_id": {
          "title": "Candidate Version Id",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "candidate_item_id",
        "candidate_version_id",
        "basis",
        "note"
      ],
      "title": "CrossVersionCandidate",
      "type": "object"
    },
    "HistoryAuditEvent": {
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "audit_id": {
          "title": "Audit Id",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "new_value": {
          "title": "New Value",
          "type": "string"
        },
        "previous_value": {
          "title": "Previous Value",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Id"
        }
      },
      "required": [
        "audit_id",
        "action",
        "stage",
        "actor",
        "previous_value",
        "new_value",
        "reason",
        "created_at"
      ],
      "title": "HistoryAuditEvent",
      "type": "object"
    },
    "HistoryConfirmation": {
      "properties": {
        "confirmation_id": {
          "title": "Confirmation Id",
          "type": "string"
        },
        "confirmed_hs": {
          "title": "Confirmed Hs",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "previous_hs": {
          "title": "Previous Hs",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "confirmation_id",
        "item_id",
        "revision",
        "previous_hs",
        "confirmed_hs",
        "reason",
        "created_by",
        "created_at"
      ],
      "title": "HistoryConfirmation",
      "type": "object"
    },
    "HistoryIssue": {
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "kind",
        "message",
        "status",
        "created_at"
      ],
      "title": "HistoryIssue",
      "type": "object"
    },
    "HistoryItemRef": {
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "source_location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "supplier_hs_raw": {
          "title": "Supplier Hs Raw",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "name",
        "supplier_hs_raw",
        "revision",
        "source_location"
      ],
      "title": "HistoryItemRef",
      "type": "object"
    },
    "HistoryRun": {
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "is_current": {
          "title": "Is Current",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/RunKind"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "submission_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submission Id"
        }
      },
      "required": [
        "run_id",
        "kind",
        "status",
        "is_current",
        "created_at"
      ],
      "title": "HistoryRun",
      "type": "object"
    },
    "HistorySubmission": {
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "decisions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Decisions",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/SubmissionLineOut"
          },
          "title": "Items",
          "type": "array"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/SubmissionStatus"
        },
        "submission_id": {
          "title": "Submission Id",
          "type": "string"
        }
      },
      "required": [
        "submission_id",
        "revision",
        "status",
        "created_by",
        "created_at",
        "items"
      ],
      "title": "HistorySubmission",
      "type": "object"
    },
    "HistoryVersion": {
      "properties": {
        "confirmations": {
          "items": {
            "$ref": "#/$defs/HistoryConfirmation"
          },
          "title": "Confirmations",
          "type": "array"
        },
        "is_current": {
          "title": "Is Current",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/HistoryItemRef"
          },
          "title": "Items",
          "type": "array"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "original_filename": {
          "title": "Original Filename",
          "type": "string"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/HistoryRun"
          },
          "title": "Runs",
          "type": "array"
        },
        "submissions": {
          "items": {
            "$ref": "#/$defs/HistorySubmission"
          },
          "title": "Submissions",
          "type": "array"
        },
        "uploaded_at": {
          "title": "Uploaded At",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "number",
        "original_filename",
        "uploaded_at",
        "is_current",
        "items",
        "confirmations",
        "runs",
        "submissions"
      ],
      "title": "HistoryVersion",
      "type": "object"
    },
    "RunKind": {
      "enum": [
        "precheck",
        "expert_check"
      ],
      "title": "RunKind",
      "type": "string"
    },
    "RunStatus": {
      "description": "技术执行状态。部分行失败由 ``progress.failed`` 表达，不改写本状态。",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "superseded"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SourceLocation": {
      "description": "商品行在原 Excel 中的位置；行号为 1 起始。",
      "properties": {
        "cells": {
          "default": "",
          "title": "Cells",
          "type": "string"
        },
        "row_number": {
          "minimum": 1,
          "title": "Row Number",
          "type": "integer"
        },
        "sheet_name": {
          "title": "Sheet Name",
          "type": "string"
        }
      },
      "required": [
        "sheet_name",
        "row_number"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "SubmissionLineOut": {
      "properties": {
        "confirmation_id": {
          "title": "Confirmation Id",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "item_revision": {
          "title": "Item Revision",
          "type": "integer"
        },
        "submitted_hs": {
          "title": "Submitted Hs",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "confirmation_id",
        "submitted_hs",
        "item_revision"
      ],
      "title": "SubmissionLineOut",
      "type": "object"
    },
    "SubmissionStatus": {
      "enum": [
        "pending",
        "approved",
        "returned",
        "superseded"
      ],
      "title": "SubmissionStatus",
      "type": "string"
    },
    "TaskStage": {
      "enum": [
        "uploaded",
        "prechecking",
        "awaiting_confirmation",
        "submitted",
        "approved",
        "returned"
      ],
      "title": "TaskStage",
      "type": "string"
    }
  },
  "properties": {
    "audit_events": {
      "items": {
        "$ref": "#/$defs/HistoryAuditEvent"
      },
      "title": "Audit Events",
      "type": "array"
    },
    "cross_version_candidates": {
      "items": {
        "$ref": "#/$defs/CrossVersionCandidate"
      },
      "title": "Cross Version Candidates",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/HistoryIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "revision": {
      "title": "Revision",
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/TaskStage"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/HistoryVersion"
      },
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "stage",
    "revision",
    "versions",
    "cross_version_candidates",
    "issues",
    "audit_events"
  ],
  "title": "TaskHistoryOut",
  "type": "object"
}
