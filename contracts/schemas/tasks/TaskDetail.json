{
  "$defs": {
    "Action": {
      "description": "``allowed_actions`` 的取值，与服务层权限常量一一对应。",
      "enum": [
        "read",
        "version.create",
        "confirmation.write",
        "submission.create",
        "decision.resolve",
        "task.return"
      ],
      "title": "Action",
      "type": "string"
    },
    "HistoryIssue": {
      "description": "人工问题的确切归属。旧记录无法证明的引用保留 null，不猜测到当前版本。",
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "default": "",
          "title": "Created By",
          "type": "string"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Id"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "return_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return To"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "submission_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submission Id"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Id"
        }
      },
      "required": [
        "issue_id",
        "task_id",
        "kind",
        "message",
        "status",
        "created_at"
      ],
      "title": "HistoryIssue",
      "type": "object"
    },
    "ResultMode": {
      "description": "结果来源模式。mock 结果必须在页面上可识别，不冒充真实引擎结论。",
      "enum": [
        "mock",
        "live"
      ],
      "title": "ResultMode",
      "type": "string"
    },
    "RunKind": {
      "enum": [
        "precheck",
        "expert_check"
      ],
      "title": "RunKind",
      "type": "string"
    },
    "RunStatus": {
      "description": "技术执行状态。部分行失败由 ``progress.failed`` 表达，不改写本状态。",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "superseded"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SourceLocation": {
      "description": "商品行在原 Excel 中的位置；行号为 1 起始。",
      "properties": {
        "cells": {
          "default": "",
          "title": "Cells",
          "type": "string"
        },
        "row_number": {
          "minimum": 1,
          "title": "Row Number",
          "type": "integer"
        },
        "sheet_name": {
          "title": "Sheet Name",
          "type": "string"
        }
      },
      "required": [
        "sheet_name",
        "row_number"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "SubmissionStatus": {
      "enum": [
        "pending",
        "approved",
        "returned",
        "superseded"
      ],
      "title": "SubmissionStatus",
      "type": "string"
    },
    "TaskStage": {
      "enum": [
        "uploaded",
        "prechecking",
        "awaiting_confirmation",
        "submitted",
        "approved",
        "returned"
      ],
      "title": "TaskStage",
      "type": "string"
    },
    "VersionEntry": {
      "properties": {
        "is_current": {
          "title": "Is Current",
          "type": "boolean"
        },
        "number": {
          "description": "V1 为 1；同任务内唯一",
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "original_filename": {
          "title": "Original Filename",
          "type": "string"
        },
        "uploaded_at": {
          "title": "Uploaded At",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "number",
        "original_filename",
        "uploaded_at",
        "is_current"
      ],
      "title": "VersionEntry",
      "type": "object"
    }
  },
  "properties": {
    "allowed_actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "title": "Allowed Actions",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "current_submission_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Submission Id"
    },
    "current_submission_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubmissionStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "current_version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Version Id"
    },
    "current_version_number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Version Number"
    },
    "latest_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Run Id"
    },
    "latest_run_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latest_run_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "precheck_allowed": {
      "default": false,
      "title": "Precheck Allowed",
      "type": "boolean"
    },
    "result_mode": {
      "$ref": "#/$defs/ResultMode"
    },
    "review_issues": {
      "items": {
        "$ref": "#/$defs/HistoryIssue"
      },
      "title": "Review Issues",
      "type": "array"
    },
    "revision": {
      "title": "Revision",
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/TaskStage"
    },
    "supplier": {
      "description": "供应商显示名",
      "title": "Supplier",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/VersionEntry"
      },
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "title",
    "stage",
    "supplier",
    "revision",
    "allowed_actions",
    "result_mode",
    "created_at",
    "updated_at"
  ],
  "title": "TaskDetail",
  "type": "object"
}
