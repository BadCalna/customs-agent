{
  "$defs": {
    "AttemptEntry": {
      "properties": {
        "error_code": {
          "default": "",
          "title": "Error Code",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "input_hash": {
          "default": "",
          "title": "Input Hash",
          "type": "string"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "number",
        "status",
        "started_at"
      ],
      "title": "AttemptEntry",
      "type": "object"
    },
    "ComparisonStatus": {
      "description": "D4 第 2 节六类比较结论，优先级按声明顺序递减。",
      "enum": [
        "association_error",
        "supplier_missing",
        "supplier_invalid",
        "needs_confirmation",
        "consistent",
        "inconsistent"
      ],
      "title": "ComparisonStatus",
      "type": "string"
    },
    "EvidenceStatus": {
      "description": "逐来源的证据取得状态；查询失败与确实未查得必须分开。",
      "enum": [
        "obtained",
        "not_found",
        "query_failed",
        "version_unverified"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "IssueEntry": {
      "description": "补料或异常问题，定位到具体商品与字段。",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "missing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "缺少什么事实或资料",
          "title": "Missing"
        },
        "suggested_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "建议由哪个角色补充；最终责任人由人工决定",
          "title": "Suggested Role"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "IssueEntry",
      "type": "object"
    },
    "RunStatus": {
      "description": "技术执行状态。部分行失败由 ``progress.failed`` 表达，不改写本状态。",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "superseded"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SourceLocation": {
      "description": "商品行在原 Excel 中的位置；行号为 1 起始。",
      "properties": {
        "cells": {
          "default": "",
          "title": "Cells",
          "type": "string"
        },
        "row_number": {
          "minimum": 1,
          "title": "Row Number",
          "type": "integer"
        },
        "sheet_name": {
          "title": "Sheet Name",
          "type": "string"
        }
      },
      "required": [
        "sheet_name",
        "row_number"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "properties": {
    "attempt_history": {
      "items": {
        "$ref": "#/$defs/AttemptEntry"
      },
      "title": "Attempt History",
      "type": "array"
    },
    "attempts": {
      "default": 0,
      "description": "本执行行实际调用次数；排队未调用为 0",
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "comparison_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComparisonStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "error_message": {
      "default": "",
      "description": "技术失败原因；缺事实不算技术失败",
      "title": "Error Message",
      "type": "string"
    },
    "evidence_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/IssueEntry"
      },
      "title": "Issues",
      "type": "array"
    },
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "origin_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin Run Id"
    },
    "source_location": {
      "$ref": "#/$defs/SourceLocation"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "suggested_hs": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "未生成建议为 null，不填假码",
      "title": "Suggested Hs"
    }
  },
  "required": [
    "item_id",
    "source_location",
    "status"
  ],
  "title": "RunItemEntry",
  "type": "object"
}
