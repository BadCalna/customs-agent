# HTTPS 示例：只有拿到域名 + 证书后才需要，纯 IP 测试不要用这一份。
#
# 步骤（细节见 deploy/README.md 第 6 节）：
# 1. 把证书放到服务器上的部署目录（不要提交进仓库）：deploy/certs/fullchain.pem、privkey.pem
# 2. 用本文件替换 deploy/nginx/default.conf（或另存并改 compose 的挂载路径）
# 3. compose 里给 web 增加 443 端口映射：- "${CUSTOMS_HTTPS_PORT:-8443}:443"
# 4. deploy/.env 设置 CUSTOMS_HTTPS=1 与 CUSTOMS_CSRF_TRUSTED_ORIGINS=https://<你的域名>
#
# 注意：CUSTOMS_CSRF_TRUSTED_ORIGINS 必须与实际访问的 scheme + host 完全一致，
# 否则登录后的写请求（确认/提交/决定）会被 CSRF 校验以 403 拒绝。

server {
    listen 80 default_server;
    server_name _;
    client_max_body_size 110m;
    # 有证书后把 HTTP 全部跳转到 HTTPS；如果还没配好证书，先别启用这一段。
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name test.example.com;   # 改成你的域名

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 110m;

    location /static/ {
        alias /usr/share/nginx/static/;
        access_log off;
        expires 1h;
    }

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
