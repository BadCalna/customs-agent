# 云端测试环境变量模板（P22）
#
# 用法：
#   cp deploy/.env.example deploy/.env
#   然后填写数据库、域名和获批准的模型服务参数。
#   deploy/.env 已被 .gitignore 忽略（.env 规则对任意目录生效），不要把填好的文件提交。
#
# 生成随机值（在服务器上执行，不要复用本文件里的示例值）：
#   openssl rand -base64 48 | tr -d '\n'          # DJANGO_SECRET_KEY
#   openssl rand -base64 24 | tr -d '\n'          # CUSTOMS_PG_PASSWORD
#
# 本文件只是模板：所有留空的必填项必须在部署机器上填写。

# ---------------------------------------------------------------------------
# 必填
# ---------------------------------------------------------------------------

# Django 密钥。泄露等于会话可伪造；每套环境各自生成一份，不要和本机 .local/dev-secret 相同。
# 把 `openssl rand -base64 48 | tr -d '\n'` 的输出粘在等号右边；留空会启动失败（有意的）。
DJANGO_SECRET_KEY=

# 数据库密码。compose 里的 db 与 app 都用这一份；改了要同时重建 db 容器或改库内口令。
CUSTOMS_PG_PASSWORD=

# 允许访问的 Host，逗号分隔：填服务器公网 IP、内网 IP、域名。
# 例：CUSTOMS_ALLOWED_HOSTS=203.0.113.10,10.0.0.5（示例 IP 必须替换；域名同样须为实际授权域名）。
# 不接受 *、change-me 或 example.com 等模板值；回环健康检查地址由部署设置自动并入。
# 不填会导致容器启动即失败（settings_cloud 的强制检查）。
CUSTOMS_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# 常用可调项（不填就用下面注释里的默认值）
# ---------------------------------------------------------------------------

# ---- 数据库 ----
# settings_cloud 已把后端固定为 postgres，这里只是显式写出来便于阅读。
CUSTOMS_DB_BACKEND=postgres
CUSTOMS_PG_NAME=customs_agent
CUSTOMS_PG_USER=customs_agent
CUSTOMS_PG_HOST=db
CUSTOMS_PG_PORT=5432

# ---- TLS 反向代理后端端口 ----
# 默认只绑定服务器回环地址。公网 TLS 入口由现有反向代理提供。
CUSTOMS_HTTP_BIND=127.0.0.1
CUSTOMS_HTTP_PORT=8080

# ---- Django 开关 ----
# 正式环境固定关闭 DEBUG。/demo/ 与 /workbench/ 仅供开发；正式入口是 /。
CUSTOMS_DEBUG=0

# CSRF 允许的来源，写在别的域/端口发写请求时才需要，必须带协议。
# 例：CUSTOMS_CSRF_TRUSTED_ORIGINS=https://test.example.com
CUSTOMS_CSRF_TRUSTED_ORIGINS=

# 正式环境必须通过现有 TLS 反向代理访问，并发送 X-Forwarded-Proto: https。
CUSTOMS_HTTPS=1

# ---- 应用模式（当前能力的真实状态）----
# live  = 页面读真实数据库；fixture = 只读契约样例（不校验权限）。
CUSTOMS_PAGE_MODE=live
# 正式环境必须使用真实 AI；模型返回的建议仍须人工核验。
CUSTOMS_ENGINE_MODE=openai
CUSTOMS_AI_API_BASE=
CUSTOMS_AI_MODEL=
CUSTOMS_AI_API_KEY=
# 仅当公司内网模型服务只提供 HTTP 时显式设置 1。
CUSTOMS_AI_ALLOW_HTTP=0
CUSTOMS_AI_TIMEOUT_SECONDS=60
# Compose 固定使用 rq，并同时启动 Redis、worker 与 dispatcher。
CUSTOMS_EXECUTOR_MODE=rq
CUSTOMS_QUEUE_NAME=customs
CUSTOMS_REDIS_URL=redis://redis:6379/0

# ---- 文件存储 ----
# 必须是 /srv/customs 持久卷的严格子目录（不是卷根本身）。
# 只接受规范绝对路径，禁止 ../、控制字符与现有 symlink；默认 files 可写。
# 镜像另预建 app 可写的 /srv/customs/restores，恢复脚本在其下创建隔离版本，不写卷根。
# 切换到其他同卷目录前须由运维预建并授予 UID 10001 写权限，卷根保持 root 所有。
CUSTOMS_FILE_ROOT=/srv/customs/files
# 单文件/单图/单次读取上限（字节）。改大时要同步改 deploy/nginx/default.conf 的 client_max_body_size。
# CUSTOMS_FILE_MAX_BYTES=104857600
# CUSTOMS_IMAGE_MAX_BYTES=20971520
# CUSTOMS_FILE_READ_MAX_BYTES=209715200

# ---- 镜像与 Compose 标识 ----
# 升级时可改成日期或提交前缀，便于 docker images 里分辨版本。
CUSTOMS_IMAGE_TAG=local
# 演练时用另一个 project 名，卷和服务名会自动隔离，不影响正式测试环境。
CUSTOMS_COMPOSE_PROJECT=customs-agent
